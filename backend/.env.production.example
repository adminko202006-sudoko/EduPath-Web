APP_NAME=EduPath
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://edupath.example
FRONTEND_URL=https://edupath.example
CORS_ALLOWED_ORIGINS=https://edupath.example

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=edupath
DB_USERNAME=edupath
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=EduPath

# Keep this service-account file outside the web root and deployment archive.
FIREBASE_CREDENTIALS=/etc/edupath/firebase-credentials.json
